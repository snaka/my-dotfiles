[user]
	name = Shinji Nakamatsu
	email = 19329+snaka@users.noreply.github.com
[alias]
	co = checkout
	st = status
	br = branch
	prune-no-longer-exist = "!git branch -vv | grep ': gone]' | grep -v '\\*' | grep -v '\\+' | awk '{ print $1; }' | xargs -r git branch -D"
	submodule-pull = submodule update --remote
	submodule-checkout = submodule update --init --recursive
	pu = "!git push -u origin $(git rev-parse --abbrev-ref HEAD)"
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
	editor = nvim
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[push]
	default = simple
[pull]
	rebase = true
	ff = only
[fetch]
	prune = true
[merge]
	ff = false
	conflictstyle = diff3
[diff]
	colorMoved = default
[grep]
	lineNumber = true
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential]
	helper = osxkeychain
# 端末固有の設定 (signingkey, gpg.ssh.program 等) は ~/.gitconfig.local に置く
[include]
	path = ~/.gitconfig.local
